<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Toolbar row: visible in drawer, hidden on home screen. -->
    <LinearLayout
        android:id="@+id/toolbar_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#121212"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/search_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="Search apps"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:autofillHints="" />

        <ImageView
            android:id="@+id/toggle_view"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_view_list"
            app:tint="#AAAAAA"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle headers" />

        <ImageView
            android:id="@+id/settings_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="#AAAAAA"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings" />

        <ImageView
            android:id="@+id/mode_switch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_mode_switch"
            app:tint="#BB86FC"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch view" />

    </LinearLayout>

    <TextView
        android:id="@+id/usage_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="#2A2438"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#D7C9FF"
        android:textSize="13sp"
        android:text="Tap to grant usage access so apps can sort by how much you use them" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:indeterminateTint="#BB86FC" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>
